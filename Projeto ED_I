		vetor[i] = 0; // e iguala todos os numeros no vetor a 0
	}
	printf("Vetor completamente limpo com sucesso!!!");
	qtd = 0; // apos igualar tudo a 0. Coloca a variavel qtd com valor 0 para indicar que o vetor estah vazio
	getch();
}

